# sort-buddy environment variables
# Copy this file to .env and fill in the placeholders.

# LLM provider: openai or ollama
LLM_PROVIDER="[your-value]"
LLM_BASE_URL="[your-value]"
LLM_API_KEY="[your-value]"
LLM_MODEL="[your-value]"
LLM_TIMEOUT="[your-value]"

# Legacy OpenAI settings (used as fallbacks when the LLM_* variables are not set)
OPENAI_API_KEY="[your-openai-api-key]"
OPENAI_API_URL="[your-value]"
OPENAI_MODEL="[your-value]"

# Email provider: generic, gmail, or yahoo
EMAIL_PROVIDER="[your-value]"
IMAP_HOST="[your-value]"
IMAP_PORT="[your-value]"
IMAP_USE_SSL="[your-value]"
EMAIL_USERNAME="[your-value]"
EMAIL_PASSWORD="[your-value]"
FOLDER_PREFIX="[your-value]"

# Gmail provider (use when EMAIL_PROVIDER=gmail)
GMAIL_USERNAME="[your-value]"
GMAIL_APP_PASSWORD="[your-value]"
GMAIL_LABEL_PREFIX="[your-value]"

# Yahoo provider (use when EMAIL_PROVIDER=yahoo)
YAHOO_USERNAME="[your-value]"
YAHOO_APP_PASSWORD="[your-value]"
YAHOO_FOLDER_PREFIX="[your-value]"

# Multi-Account Example Variables
# These are example environment variables for use with accounts.yaml in multi-account mode.
# Reference these in your accounts.yaml using ${VAR_NAME} syntax.
# Example: password: ${WORK_EMAIL_PASSWORD}

# Work Exchange account
WORK_EMAIL_PASSWORD="[your-work-password]"

# Personal Gmail account
PERSONAL_GMAIL_APP_PASSWORD="[your-gmail-app-password]"

# Personal Yahoo account
YAHOO_APP_PASSWORD="[your-yahoo-app-password]"
